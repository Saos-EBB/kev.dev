{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/adhdActivated",
      "permanent": false
    },
    {
      "source": "/agressiveIntro",
      "destination": "/adhdActivated",
      "permanent": true
    },
    {
      "source": "/graph/:id(yourbrand|tschobbo|kevdev)",
      "destination": "/lessAdhd#eng/:id",
      "permanent": true
    },
    {
      "source": "/graph/:id(yourbrand|tschobbo|kevdev).html",
      "destination": "/lessAdhd#eng/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/adhdActivated/:path*",
      "destination": "/adhdActivated.html"
    }
  ]
}
